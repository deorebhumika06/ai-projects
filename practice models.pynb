        "id": "c60b6bef"
      },
      "source": [
        "### Data Preprocessing\n",
        "\n",
        "First, we'll prepare the data by dropping the `id` column, which is usually just an identifier and not a predictive feature. We'll also separate features (X) from the target variable (y).\n",
        "\n",
        "**Please replace `\"target_variable_name\"` with the actual column you want to predict from your dataset.**"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 382
        },
        "id": "c0eb8cde",
        "outputId": "603bbe97-9fc0-4375-e5da-e187e89409da"
      },
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Drop the 'id' column as it's not a feature\n",
        "X = df.drop(columns=['id'])\n",
        "\n",
        "# Define your target variable (y)\n",
        "# IMPORTANT: You need to replace 'pc' with the actual continuous numerical column you want to predict.\n",
        "try:\n",
        "    target_variable_name = 'pc' # Changed to 'pc' for regression task\n",
        "    y = df[target_variable_name]\n",
        "    X = X.drop(columns=[target_variable_name]) # Remove target from features\n",
        "    print(f\"Target variable '{target_variable_name}' selected.\")\n",
        "except KeyError:\n",
        "    print(\"Warning: The specified target variable was not found in the DataFrame.\")\n",
        "    print(\"Please update `target_variable_name` in the code below with the correct column name from your dataset.\")\n",
        "    print(\"For now, we will proceed without a target variable, which means the regression forest training step will not work correctly.\")\n",
        "    y = None # No target variable for now\n",
        "\n",
        "print(\"Features (X) head:\")\n",
        "display(X.head())\n",
        "if y is not None:\n",
        "    print(\"Target (y) head:\")\n",
        "    print(y.head())"
      ],
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
