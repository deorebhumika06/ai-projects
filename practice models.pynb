      "source": [
        "### Visualizing Model Performance"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 555
        },
        "id": "b6c90b5e",
        "outputId": "ef7d549a-ae5b-49d6-bc6a-620a182c02d9"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Assuming results_df from the previous step is available\n",
        "# results_df contains 'Model', 'R-squared', 'Mean Squared Error'\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
        "fig.suptitle('Regression Model Performance Comparison', fontsize=16)\n",
        "\n",
        "# Bar plot for R-squared\n",
        "sns.barplot(ax=axes[0], x='Model', y='R-squared', data=results_df, palette='viridis')\n",
        "axes[0].set_title('R-squared (Higher is Better)')\n",
        "axes[0].set_ylabel('R-squared Score')\n",
        "axes[0].set_ylim(results_df['R-squared'].min() - 0.5, results_df['R-squared'].max() + 0.1)\n",
        "axes[0].tick_params(axis='x', rotation=45)\n",
        "\n",
        "# Bar plot for Mean Squared Error\n",
        "sns.barplot(ax=axes[1], x='Model', y='Mean Squared Error', data=results_df, palette='magma')\n",
        "axes[1].set_title('Mean Squared Error (Lower is Better)')\n",
        "axes[1].set_ylabel('Mean Squared Error')\n",
        "axes[1].set_ylim(0, results_df['Mean Squared Error'].max() * 1.1) # Start from 0 for MSE\n",
        "axes[1].tick_params(axis='x', rotation=45)\n",
        "\n",
        "plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n",
        "plt.show()\n",
        "\n",
        "print(\"\\n**Conclusion from Visualization:**\")\n",
        "print(\"As expected, all models show very poor performance, likely due to the extremely limited dataset size. The R-squared values are negative, indicating that the models are performing worse than a simple horizontal line at the mean of the target variable. Mean Squared Errors are also very high.\")\n",
        "print(\"To achieve better predictive performance, a significantly larger dataset would be required.\")"
      ],
      "execution_count": 22,
      "outputs": [
