    {
      "cell_type": "markdown",
      "metadata": {
        "id": "06c3bef9"
      },
      "source": [
        "### Model Comparison\n",
        "\n",
        "Let's compare the R-squared and Mean Squared Error for all three regression models."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 302
        },
        "id": "14e085de",
        "outputId": "a259a6f7-fdc3-43be-9762-4af9bc303999"
      },
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Create a dictionary to store model results\n",
        "results = {\n",
        "    'Model': ['Decision Tree Regressor', 'Random Forest Regressor', 'XGBoost Regressor'],\n",
        "    'R-squared': [r2_dtree, r2_rf, r2_xgb],\n",
        "    'Mean Squared Error': [mse_dtree, mse_rf, mse_xgb]\n",
        "}\n",
        "\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
        "# Display the comparison table\n",
        "print(\"\\nModel Performance Comparison:\")\n",
        "display(results_df.round(4))\n",
        "\n",
        "print(\"\\n**Interpretation:**\")\n",
        "print(\" - R-squared (higher is better): Represents the proportion of variance in the target variable predictable from the features.\")\n",
        "print(\" - Mean Squared Error (lower is better): Measures the average squared difference between the estimated values and the actual value.\")\n",
        "print(\"\\nDue to the very small dataset size, the R-squared values might be negative or highly variable, indicating that the models are not performing well and might be overfitting or underfitting severely. This is a common issue with insufficient data.\")"
      ],
      "execution_count": 21,
