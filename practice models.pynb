      "source": [
        "### Data Preprocessing for New Dataset"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 848
        },
        "id": "d08de956",
        "outputId": "cdd2a19f-327a-423b-ed1d-68a207b07cc6"
      },
      "source": [
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import OneHotEncoder\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "# Load the new dataset (assuming it's already loaded into 'df' from previous step)\n",
        "# If not, please run: df = pd.read_csv(\"/content/Best Selling Mobile Phones 2020.csv\")\n",
        "\n",
        "df_new = df.copy() # Work on a copy of the new dataframe\n",
        "\n",
        "print(\"Original DataFrame head:\")\n",
        "display(df_new.head())\n",
        "print(\"Original DataFrame info:\")\n",
        "df_new.info()\n",
        "\n",
        "# Define target and features\n",
        "target_variable_name = 'Sold(million)'\n",
        "y_new = df_new[target_variable_name]\n",
        "X_new = df_new.drop(columns=[target_variable_name, 'No']) # 'No' is likely an ID and not a feature\n",
        "\n",
        "# Identify categorical features for one-hot encoding\n",
        "categorical_features = X_new.select_dtypes(include=['object']).columns\n",
        "\n",
        "# Create a column transformer for one-hot encoding\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=[\n",
        "        ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False), categorical_features) # Added sparse_output=False\n",
        "    ],\n",
        "    remainder='passthrough' # Keep other columns as they are (if any, though none expected here)\n",
        ")\n",
        "\n",
        "# Apply preprocessing and get feature names\n",
        "X_new_processed = preprocessor.fit_transform(X_new)\n",
        "\n",
        "# Get feature names after one-hot encoding\n",
        "feature_names = preprocessor.named_transformers_['cat'].get_feature_names_out(categorical_features)\n",
        "\n",
        "# Convert to DataFrame for better readability, if needed for inspection\n",
        "X_new_processed_df = pd.DataFrame(X_new_processed, columns=feature_names)\n",
        "\n",
        "print(\"\\nProcessed Features (X_new_processed_df) head:\")\n",
        "display(X_new_processed_df.head())\n",
        "\n",
        "# Split the processed data into training and testing sets\n",
        "X_train_new, X_test_new, y_train_new, y_test_new = train_test_split(X_new_processed, y_new, test_size=0.2, random_state=42)\n",
        "\n",
        "print(f\"\\nShape of X_train_new: {X_train_new.shape}\")\n",
        "print(f\"Shape of X_test_new: {X_test_new.shape}\")\n",
        "print(f\"Shape of y_train_new: {y_train_new.shape}\")\n",
        "print(f\"Shape of y_test_new: {y_test_new.shape}\")"
      ],
      "execution_count": 17,
      "outputs": [
