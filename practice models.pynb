    {
      "cell_type": "markdown",
      "metadata": {
        "id": "5eddc734"
      },
      "source": [
        "### Decision Tree Regressor Model"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "24936a78",
        "outputId": "8aed9d9f-9856-4061-9ac2-2d3d7da78bf8"
      },
      "source": [
        "from sklearn.tree import DecisionTreeRegressor\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "\n",
        "# Initialize the Decision Tree Regressor\n",
        "dtree_reg = DecisionTreeRegressor(random_state=42)\n",
        "\n",
        "# Train the model\n",
        "dtree_reg.fit(X_train_new, y_train_new)\n",
        "\n",
        "# Make predictions on the test set\n",
        "y_pred_dtree = dtree_reg.predict(X_test_new)\n",
        "\n",
        "# Evaluate the model\n",
        "mse_dtree = mean_squared_error(y_test_new, y_pred_dtree)\n",
        "r2_dtree = r2_score(y_test_new, y_pred_dtree)\n",
        "\n",
        "print(f\"Decision Tree Regressor Mean Squared Error: {mse_dtree:.4f}\")\n",
        "print(f\"Decision Tree Regressor R-squared: {r2_dtree:.4f}\")\n",
        "\n",
        "print(\"\\nDecision Tree Regressor Model trained and evaluated successfully.\")"
      ],
      "execution_count": 18,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Decision Tree Regressor Mean Squared Error: 349.0000\n",
            "Decision Tree Regressor R-squared: -12.9600\n",
            "\n",
            "Decision Tree Regressor Model trained and evaluated successfully.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "b749ead7"
      },
      "source": [
        "### Random Forest Regressor Model"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "77717eea",
        "outputId": "a0c575e6-9a9b-4928-e599-20d47d188a63"
      },
      "source": [
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "\n",
        "# Initialize the Random Forest Regressor\n",
        "rf_reg = RandomForestRegressor(n_estimators=100, random_state=42)\n",
        "\n",
        "# Train the model\n",
        "rf_reg.fit(X_train_new, y_train_new)\n",
        "\n",
        "# Make predictions on the test set\n",
        "y_pred_rf = rf_reg.predict(X_test_new)\n",
        "\n",
        "# Evaluate the model\n",
        "mse_rf = mean_squared_error(y_test_new, y_pred_rf)\n",
        "r2_rf = r2_score(y_test_new, y_pred_rf)\n",
        "\n",
        "print(f\"Random Forest Regressor Mean Squared Error: {mse_rf:.4f}\")\n",
        "print(f\"Random Forest Regressor R-squared: {r2_rf:.4f}\")\n",
        "\n",
        "print(\"\\nRandom Forest Regressor Model trained and evaluated successfully.\")"
      ],
      "execution_count": 19,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Random Forest Regressor Mean Squared Error: 287.1550\n",
            "Random Forest Regressor R-squared: -10.4862\n",
            "\n",
            "Random Forest Regressor Model trained and evaluated successfully.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "2053fd52"
      },
      "source": [
        "### XGBoost Regressor Model"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c88e5740",
        "outputId": "5c07ffa2-c15d-43ad-c0f6-061b602f9977"
      },
      "source": [
        "# Install xgboost if not already installed\n",
        "!pip install xgboost\n",
        "\n",
        "import xgboost as xgb\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "\n",
        "# Initialize the XGBoost Regressor\n",
        "xgb_reg = xgb.XGBRegressor(objective='reg:squarederror', n_estimators=100, random_state=42)\n",
        "\n",
        "# Train the model\n",
        "xgb_reg.fit(X_train_new, y_train_new)\n",
        "\n",
        "# Make predictions on the test set\n",
        "y_pred_xgb = xgb_reg.predict(X_test_new)\n",
        "\n",
        "# Evaluate the model\n",
        "mse_xgb = mean_squared_error(y_test_new, y_pred_xgb)\n",
        "r2_xgb = r2_score(y_test_new, y_pred_xgb)\n",
        "\n",
        "print(f\"XGBoost Regressor Mean Squared Error: {mse_xgb:.4f}\")\n",
        "print(f\"XGBoost Regressor R-squared: {r2_xgb:.4f}\")\n",
        "\n",
        "print(\"\\nXGBoost Regressor Model trained and evaluated successfully.\")"
      ],
      "execution_count": 20,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
